#!/opt/mixos/bin/mix
-- SPDX-FileCopyrightText: 2026 Mark Constable <mc@mixos.dev>
-- SPDX-License-Identifier: MIT OR Apache-2.0

-- Preflight BEFORE training; write with these non-root credentials.
fn mail_identity($path)
  $st = stat($path, {follow_symlinks: false})
  if not $st.is_dir or $st.uid == 0 or $st.gid == 0 then
    raise("MAIL_IDENTITY", $path .. " must be a real directory with non-root uid/gid")
  end
  return $st
end

fn mail_append($identity, $path, $text)
  $w = run_argv(["setpriv", "--reuid", to_string($identity.uid), "--regid", to_string($identity.gid), "--clear-groups", "tee", "-a", "--", $path], {stdin: $text, stdout: "null"})
  if $w.exit_code != 0 then raise("SIDECAR_APPEND", $path .. ": " .. $w.stderr) end
end

-- Private scratch: never follow a pre-planted parent or recreate its parents.
fn private_stage()
  try
    $st = stat("/run/spamlite", {follow_symlinks: false})
  catch $e
    $mk = run_argv(["mkdir", "-m", "0700", "--", "/run/spamlite"])
    -- A concurrent creator is allowed only if the lstat below passes.
    if $mk.exit_code != 0 and not is_dir("/run/spamlite") then raise("STAGE_PARENT", $mk.stderr) end
  end
  $st = stat("/run/spamlite", {follow_symlinks: false})
  if not $st.is_dir or $st.uid != 0 or $st.gid != 0 or $st.perm % 64 != 0 then
    raise("STAGE_PARENT", "/run/spamlite must be a real root-owned directory without group/other access")
  end
  $dir = "/run/spamlite/stage-" .. uuid()
  mkdir($dir, {parents: false})
  $ready = false
  try
    chmod($dir, 0o700)
    $ready = true
    return $dir
  finally
    if not $ready then remove_dir($dir) end
  end
end
-- spamlite-junk-rescue.mix — retrain a REVIEWED list of Junk false positives
-- as good and (optionally) move recent ones back to INBOX. 2026-09-17.
--
--   spamlite-junk-rescue.mix dry|apply <list.tsv> <move-cutoff YYYY-MM-DD>
--
-- list.tsv columns: login, message_id, mailbox, received ("YYYY-MM-DD ...").
-- Per user: back up db + sidecar, stage each message byte-exact via doveadm,
-- verify its Message-ID, then as the mail user:
--   sidecar last entry S (1 entry)  -> train-dir good --from spam  (2nd entry freezes G)
--   no sidecar entry                -> train-dir good, and ALWAYS moved out of Junk
--                                      (a G-only key left in Junk would be flipped
--                                      back to S by the nightly reconciler)
--   already G, or frozen            -> not retrained (reported)
-- A G sidecar line is appended per ok row. Messages received on/after the
-- cutoff are moved to INBOX; older retrained ones stay in Junk, frozen as G.

$SL = "/usr/local/bin/spamlite"
$STAMP = to_string(floor(time()))
$a = args()
if len($a) < 3 then
  print("usage: spamlite-junk-rescue.mix dry|apply <list.tsv> <YYYY-MM-DD>")
  exit(1)
end
$mode = $a[0]
$CUT = $a[2]
$W = private_stage()

try
$by = {}
for $l in lines(read_file($a[1]))
  $c = split($l, "\t")
  if len($c) >= 4 and contains($c[0], "@") then
    if $by[$c[0]] == nil then $by[$c[0]] = [] end
    $by[$c[0]] = push($by[$c[0]], $c)
  end
end

$T = {corr: 0, plain: 0, skipped: 0, moved: 0, missing: 0, failed: 0}
for $login in sort(keys($by))
  $up = split($login, "@")
  -- NS 3.0 /srv/<dom>/msg/<user>, else NS 1.0 /home/u/<dom>/home/<user>
  $db = "/srv/" .. $up[1] .. "/msg/" .. $up[0] .. "/.spamlite"
  if not is_dir($db) and is_dir("/home/u/" .. $up[1] .. "/home/" .. $up[0] .. "/.spamlite") then
    $db = "/home/u/" .. $up[1] .. "/home/" .. $up[0] .. "/.spamlite"
  end
  $log = $db .. "/reconciled.log"
  $identity = mail_identity($db)
  -- The validated numeric identity is used for both training and recording.
  $last = {}
  $cnt = {}
  if is_file($log) then
    for $l in lines(bytes_to_string(read_file_bytes($log), {lossy: true}))
      $p = split($l, " ")
      if len($p) >= 3 then
        $last[$p[2]] = $p[0]
        $cnt[$p[2]] = ($cnt[$p[2]] or 0) + 1
      end
    end
  end
  $stage = private_stage()

try
  mkdir($stage .. "/corr", {parents: false})
  mkdir($stage .. "/plain", {parents: false})
  chmod($stage .. "/corr", 0o700)
  chmod($stage .. "/plain", 0o700)
  $uidof = {}
  $boxof = {}
  $moveit = {}
  $nc = 0
  $np = 0
  $ns = 0
  $i = 0
  for $c in $by[$login]
    $k = $c[1]
    $kind = ""
    if $last[$k] == nil then
      $kind = "plain"
    else
      if $last[$k] == "S" and $cnt[$k] == 1 then $kind = "corr" end
    end
    $r = run_argv(["doveadm", "fetch", "-u", $login, "uid", "mailbox", $c[2], "header", "message-id", $k], {timeout: 120})
    $uid = ""
    for $l in lines($r.stdout)
      if $uid == "" and starts_with($l, "uid: ") then $uid = strip(after($l, "uid: ")) end
    end
    if $uid == "" then
      $T.missing = $T.missing + 1
      continue
    end
    $recent = left($c[3], 10) >= $CUT
    if $kind == "" then
      $ns = $ns + 1
      if $recent and $last[$k] == "G" then
        $uidof[$k] = $uid
        $boxof[$k] = $c[2]
        $moveit[$k] = true
      end
      continue
    end
    $i = $i + 1
    $raw = $stage .. "/raw"
    $f1 = run_argv(["doveadm", "fetch", "-u", $login, "text", "mailbox", $c[2], "uid", $uid], {stdout: {file: $raw}, timeout: 120})
    if $f1.exit_code != 0 then
      $T.failed = $T.failed + 1
      continue
    end
    $f2 = run_argv(["tail", "-n", "+2", "--", $raw], {timeout: 120, stdout: {file: $stage .. "/" .. $kind .. "/" .. $i .. ".eml", mode: 384}})
    $cleanup = run_argv(["rm", "-f", $raw])
    if $f2.exit_code != 0 then raise("STAGE_WRITE", $f2.stderr) end
    $uidof[$k] = $uid
    $boxof[$k] = $c[2]
    if $recent or $kind == "plain" then $moveit[$k] = true end
    if $kind == "corr" then $nc = $nc + 1 else $np = $np + 1 end
  end
  -- drop anything whose Message-ID isn't one we asked for
  $want = {}
  for $c in $by[$login]
    $want[$c[1]] = true
  end
  for $sub in ["corr", "plain"]
    for $l in lines(run_argv_must([$SL, "msgids", $stage .. "/" .. $sub], {timeout: 900, max_output: 256 * 1024 * 1024}))
      $f = split($l, "\t")
      if len($f) >= 3 and not $want[lower(trim($f[0], "<> "))] then
        eprint("  msgid mismatch dropped: " .. $f[2])
        $cleanup = run_argv(["rm", "-f", $f[2]])
      end
    end
  end
  $owned = run_argv_must(["chown", "-hR", to_string($identity.uid) .. ":" .. to_string($identity.gid), $stage], {timeout: 600})
  chmod($stage, 0o700)
  $nm = 0
  for $k in keys($moveit)
    $nm = $nm + 1
  end
  print($login .. ": retrain corr=" .. $nc .. " plain=" .. $np .. "  not-retrained=" .. $ns .. "  to-move=" .. $nm)
  if $mode != "apply" then continue end

  $checked = run_argv_must(["setpriv", "--reuid", to_string($identity.uid), "--regid", to_string($identity.gid), "--clear-groups", "cp", "-a", $db .. "/db.sqlite", $db .. "/db.sqlite.bak-" .. $STAMP .. "-rescue"], {timeout: 600})
  if is_file($log) then $checked = run_argv_must(["setpriv", "--reuid", to_string($identity.uid), "--regid", to_string($identity.gid), "--clear-groups", "cp", "-a", $log, $log .. ".bak-" .. $STAMP .. "-rescue"], {timeout: 600}) end
  $trained = {}
  for $sub in ["corr", "plain"]
    $argv = [$SL, "-d", $db, "train-dir", "./" .. $sub, "good"]
    if $sub == "corr" then
      $argv = concat($argv, ["--from", "spam"])
    end
    if len(ls($stage .. "/" .. $sub)) > 0 then
      $tr = run_argv(concat(["setpriv", "--reuid", to_string($identity.uid), "--regid", to_string($identity.gid), "--clear-groups"], $argv), {timeout: 900, cwd: $stage, max_output: 256 * 1024 * 1024})
      if not $tr.ok or $tr.stdout_truncated or $tr.stderr_truncated then
        eprint("  TRAIN FAILED " .. $login .. " " .. $sub .. " timed_out=" .. $tr.timed_out .. " stdout_truncated=" .. $tr.stdout_truncated .. ": " .. strip($tr.stderr))
        $T.failed = $T.failed + 1
      end
      $now = "" .. floor(time())
      $add = ""
      -- Ignore a partial final row if the process timed out or capture filled.
      for $l in slice(split($tr.stdout, "\n"), 0, -1)
        $f = split($l, "\t")
        if len($f) >= 3 and $f[0] == "ok" then
          $kk = lower(trim($f[1], "<> "))
          $add = $add .. "G " .. $now .. " " .. $kk .. "\n"
          $trained[$kk] = true
          if $sub == "corr" then $T.corr = $T.corr + 1 else $T.plain = $T.plain + 1 end
        end
      end
      if $add != "" then mail_append($identity, $log, $add) end
    end
  end
  -- move: only what was trained now, or was already G
  for $k in keys($moveit)
    if $trained[$k] or $last[$k] == "G" then
      $mv = run_argv(["doveadm", "move", "-u", $login, "INBOX", "mailbox", $boxof[$k], "uid", $uidof[$k]], {timeout: 120})
      if $mv.exit_code == 0 then
        $T.moved = $T.moved + 1
      else
        eprint("  MOVE FAILED " .. $login .. " " .. $k .. ": " .. strip($mv.stderr))
        $T.failed = $T.failed + 1
      end
    end
  end
finally
  remove_dir($stage)
end
  $T.skipped = $T.skipped + $ns
end
finally
  remove_dir($W)
end
print("TOTAL mode=" .. $mode .. " corr=" .. $T.corr .. " plain=" .. $T.plain .. " not-retrained=" .. $T.skipped .. " moved=" .. $T.moved .. " missing=" .. $T.missing .. " failed=" .. $T.failed)
