#!/opt/mixos/bin/mix
-- SPDX-FileCopyrightText: 2026 Mark Constable <mc@mixos.dev>
-- SPDX-License-Identifier: MIT OR Apache-2.0

-- Preflight BEFORE training; write with these non-root credentials.
fn mail_identity($path)
  $st = stat($path, {follow_symlinks: false})
  if not $st.is_dir or $st.uid == 0 or $st.gid == 0 then
    raise("MAIL_IDENTITY", $path .. " must be a real directory with non-root uid/gid")
  end
  return $st
end

fn mail_append($identity, $path, $text)
  $w = run_argv(["setpriv", "--reuid", to_string($identity.uid), "--regid", to_string($identity.gid), "--clear-groups", "tee", "-a", "--", $path], {stdin: $text, stdout: "null"})
  if $w.exit_code != 0 then raise("SIDECAR_APPEND", $path .. ": " .. $w.stderr) end
end

-- Private scratch: never follow a pre-planted parent or recreate its parents.
fn private_stage()
  try
    $st = stat("/run/spamlite", {follow_symlinks: false})
  catch $e
    $mk = run_argv(["mkdir", "-m", "0700", "--", "/run/spamlite"])
    -- A concurrent creator is allowed only if the lstat below passes.
    if $mk.exit_code != 0 and not is_dir("/run/spamlite") then raise("STAGE_PARENT", $mk.stderr) end
  end
  $st = stat("/run/spamlite", {follow_symlinks: false})
  if not $st.is_dir or $st.uid != 0 or $st.gid != 0 or $st.perm % 64 != 0 then
    raise("STAGE_PARENT", "/run/spamlite must be a real root-owned directory without group/other access")
  end
  $dir = "/run/spamlite/stage-" .. uuid()
  mkdir($dir, {parents: false})
  chmod($dir, 0o700)
  return $dir
end
-- spamlite-rescued-sweep.mix — find (and optionally correct) messages the nightly
-- reconciler trained as SPAM that the user has since rescued into a folder they
-- keep mail in. 2026-09-17 (ns mrn _journal/2026-09-17.md).
--
--   spamlite-rescued-sweep.mix dry [substr] -> printed private candidates.tsv path
--   spamlite-rescued-sweep.mix apply <substr-or-empty> <candidates.tsv>
--
-- Candidate = sidecar key whose ONLY entry is S (a 2-entry key is frozen), not a
-- f: fallback key, present in >= 1 "keep" mailbox and in NO junk-shaped mailbox.
-- "keep" uses the retrain-as-ham.sieve denylist (Trash/Drafts/Sent/Deleted/junk/spam),
-- widened for Outlook names (Sent Items, Detected/Infected Items, Outbox).
-- apply: backs up db + sidecar, fetches each message via doveadm (layout-proof),
-- checks its Message-ID, runs `train-dir good --from spam` as the mail user and
-- appends a G sidecar line per ok row (2nd entry freezes the key as good).

$SL = "/usr/local/bin/spamlite"
$W = private_stage()
$TSV = $W .. "/candidates.tsv"
$a = args()
$mode = "dry"
if len($a) >= 1 then $mode = $a[0] end
$filt = ""
if len($a) >= 2 then $filt = $a[1] end
-- apply consumes an explicitly reviewed dry-run TSV, never a shared scratch name.
if $mode == "apply" then
  if len($a) < 3 then raise("REVIEW_TSV", "apply requires: apply [substr] <dry-run candidates.tsv>") end
  $TSV = $a[2]
end

function junky($mb)
  $l = lower($mb)
  return contains($l, "junk") or contains($l, "spam") or contains($l, "detected items") or contains($l, "infected items")
end

function keep($mb)
  if junky($mb) then return false end
  $l = lower($mb)
  for $part in split(replace($l, "/", "."), ".")
    $p = trim($part)
    if starts_with($p, "trash") or starts_with($p, "deleted") or starts_with($p, "draft") or starts_with($p, "sent") or $p == "outbox" then
      return false
    end
  end
  return true
end

function users()
  $out = []
  for $dom in ls("/srv")
    $m = "/srv/" .. $dom .. "/msg"
    if is_dir($m) then
      for $u in ls($m)
        if is_file($m .. "/" .. $u .. "/.spamlite/reconciled.log") then
          $login = $u .. "@" .. $dom
          if $filt == "" or contains($login, $filt) then
            push($out, [$login, $m .. "/" .. $u])
          end
        end
      end
    end
  end
  return $out
end

function dry()
  $rows = ""
  $tot = {cands: 0, still_junk: 0, users: 0, failed: 0}
  $bymb = {}
  for $ud in users()
    $login = $ud[0]
    $db = $ud[1] .. "/.spamlite"
    -- sidecar: count entries + last class per key
    $n = {}
    $last = {}
    $epoch = {}
    for $l in lines(read_file($db .. "/reconciled.log"))
      $p = split($l, " ")
      if len($p) >= 3 then
        $n[$p[2]] = ($n[$p[2]] or 0) + 1
        $last[$p[2]] = $p[0]
        $epoch[$p[2]] = $p[1]
      end
    end
    $want = {}
    $any = false
    for $k in keys($n)
      if $n[$k] == 1 and $last[$k] == "S" and not starts_with($k, "f:") then
        $want[$k] = true
        $any = true
      end
    end
    if $any then
      $tot.users = $tot.users + 1
      $f = $W .. "/mids.tmp"
      $r = run_argv(["doveadm", "fetch", "-u", $login, "mailbox hdr.message-id", "all"], {stdout: {file: $f}, timeout: 900})
      if $r.exit_code != 0 then
        eprint("FETCH FAILED " .. $login .. ": " .. trim($r.stderr))
        $tot.failed = $tot.failed + 1
      else
        $locs = {}
        $mb = ""
        for $l in lines(bytes_to_string(read_file_bytes($f), {lossy: true}))
          if starts_with($l, "mailbox: ") then $mb = after($l, "mailbox: ") end
          if starts_with($l, "hdr.message-id: ") then
            $id = lower(trim(after($l, "hdr.message-id: "), "<> \t"))
            if $want[$id] then
              if $locs[$id] == nil then $locs[$id] = [] end
              if not contains($locs[$id], $mb) then $locs[$id] = push($locs[$id], $mb) end
            end
          end
        end
        for $id in keys($locs)
          $kept = ""
          $inj = false
          for $m in $locs[$id]
            if junky($m) then $inj = true end
            if $kept == "" and keep($m) then $kept = $m end
          end
          if $kept != "" and $inj then $tot.still_junk = $tot.still_junk + 1 end
          if $kept != "" and not $inj then
            $rows = $rows .. $login .. "\t" .. $id .. "\t" .. $kept .. "\t" .. $epoch[$id] .. "\n"
            $tot.cands = $tot.cands + 1
            $bymb[$kept] = ($bymb[$kept] or 0) + 1
          end
        end
      end
    end
  end
  write_file($TSV, $rows)
  chmod($TSV, 0o600)
  remove($W .. "/mids.tmp")
  print("users with S keys: " .. $tot.users .. "  fetch failures: " .. $tot.failed)
  print("candidates: " .. $tot.cands .. "  skipped (also still in junk): " .. $tot.still_junk)
  print("by mailbox:")
  for $k in keys($bymb)
    print("  " .. $bymb[$k] .. "\t" .. $k)
  end
  print("TSV: " .. $TSV)
end

function apply()
  $by = {}
  for $l in lines(read_file($TSV))
    $f = split($l, "\t")
    if len($f) >= 3 and ($filt == "" or contains($f[0], $filt)) then
      if $by[$f[0]] == nil then $by[$f[0]] = [] end
      $by[$f[0]] = push($by[$f[0]], [$f[1], $f[2]])
    end
  end
  $grand = 0
  for $login in keys($by)
    $up = split($login, "@")
    $home = "/srv/" .. $up[1] .. "/msg/" .. $up[0]
    $db = $home .. "/.spamlite"
    $identity = mail_identity($db)
    -- The validated numeric identity is used for both training and recording.
    $stage = private_stage()

    $i = 0
    for $c in $by[$login]
      -- uid first (header search is a substring match; msgids check below
      -- rejects a wrong hit), then the raw text straight to a file so
      -- non-UTF-8 mail is staged byte-exact; tail drops the "text:" line.
      $r = run_argv(["doveadm", "fetch", "-u", $login, "uid", "mailbox", $c[1], "header", "message-id", $c[0]], {timeout: 120})
      $uid = ""
      for $l in lines($r.stdout)
        if $uid == "" and starts_with($l, "uid: ") then $uid = trim(after($l, "uid: ")) end
      end
      $ok = false
      if $r.exit_code == 0 and $uid != "" then
        $i = $i + 1
        $raw = $stage .. "/raw"
        $f1 = run_argv(["doveadm", "fetch", "-u", $login, "text", "mailbox", $c[1], "uid", $uid], {stdout: {file: $raw}, timeout: 120})
        if $f1.exit_code == 0 then
          $f2 = run_argv(["tail", "-n", "+2", "--", $raw], {timeout: 120, stdout: {file: $stage .. "/" .. $i .. ".eml"}})
          $ok = $f2.exit_code == 0
        end
        $cleanup = run_argv(["rm", "-f", $raw])
      end
      if not $ok then
        eprint("  fetch miss " .. $login .. " " .. $c[0])
      end
    end
    -- drop anything whose Message-ID isn't exactly a wanted key
    $wantk = {}
    for $c in $by[$login]
      $wantk[$c[0]] = true
    end
    for $l in lines(run_argv_must([$SL, "msgids", $stage], {timeout: 900, max_output: 256 * 1024 * 1024}))
      $f = split($l, "\t")
      if len($f) >= 3 and not $wantk[lower(trim($f[0], "<> "))] then
        eprint("  msgid mismatch, dropped: " .. $f[2])
        $cleanup = run_argv(["rm", "-f", $f[2]])
      end
    end
    $owned = run_argv_must(["chown", "-hR", to_string($identity.uid) .. ":" .. to_string($identity.gid), $stage], {timeout: 600})
    chmod($stage, 0o700)
    $checked = run_argv_must(["cp", "-a", $db .. "/db.sqlite", $db .. "/db.sqlite.bak-20260917-sweep"], {timeout: 600})
    $checked = run_argv_must(["cp", "-a", $db .. "/reconciled.log", $db .. "/reconciled.log.bak-20260917-sweep"], {timeout: 600})
    $r = run_argv(["setpriv", "--reuid", to_string($identity.uid), "--regid", to_string($identity.gid), "--clear-groups", $SL, "-d", $db, "train-dir", ".", "good", "--from", "spam"], {timeout: 900, cwd: $stage, max_output: 256 * 1024 * 1024})
    if not $r.ok or $r.stdout_truncated or $r.stderr_truncated then
      eprint("TRAIN FAILED " .. $login .. " timed_out=" .. $r.timed_out .. " stdout_truncated=" .. $r.stdout_truncated .. ": " .. trim($r.stderr))
    else
      $now = "" .. floor(time())
      $add = ""
      $ok = 0
      -- Ignore a partial final row if the process timed out or capture filled.
      for $l in slice(split($r.stdout, "\n"), 0, -1)
        $f = split($l, "\t")
        if len($f) >= 3 and $f[0] == "ok" then
          $add = $add .. "G " .. $now .. " " .. lower(trim($f[1], "<> ")) .. "\n"
          $ok = $ok + 1
        end
      end
      if $add != "" then mail_append($identity, $db .. "/reconciled.log", $add) end
      $grand = $grand + $ok
      print($login .. "\tcorrected " .. $ok .. "/" .. len($by[$login]) .. "\t" .. trim($r.stderr))
    end
    remove_dir($stage)
  end
  remove_dir($W)
  print("TOTAL corrected: " .. $grand)
end

if $mode == "apply" then
  apply()
else
  dry()
end
