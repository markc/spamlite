#!/opt/cosmix/bin/mix
-- sent-swap-redo.mix — undo a pre-`--sent` Sent-folder ham top-up and re-run it
-- with the swap, for one Maildir user.
--
--   sent-swap-redo.mix <user@domain> <topup-timestamp> [--commit] [--was-sent]
--
-- The top-up writes every sidecar line with the SAME `G <ts> <key>` timestamp,
-- so that timestamp names its cohort exactly. This script:
--
--   1. backs up db.sqlite (sqlite3 .backup, consistent under WAL) + the sidecar
--   2. maps each cohort key back to its file in Maildir/.Sent/cur
--   3. untrains each as good with the SAME geometry it was trained with. A
--      cohort predating `--sent` was trained raw, so it is untrained raw; pass
--      `--was-sent` for a cohort that was itself trained with `--sent`. Getting
--      this wrong decrements tokens the train never incremented and strands the
--      ones it did, so the flag is not optional bookkeeping.
--
--      A cohort trained by a DIFFERENT binary version whose `--sent` semantics
--      have since changed cannot be reversed by any flag here — restore the db
--      backup instead.
--   4. drops the whole cohort from reconciled.log so the top-up will re-train it
--
-- Re-running the top-up (which now passes --sent) is left to the caller, so the
-- undo can be inspected before the redo. Dry-run unless --commit is given.
--
-- Keys whose message has since been deleted from Sent cannot be untrained;
-- their ham counts are stranded in the db permanently and are reported as such.
$a = args()
if len($a) < 2 then print("usage: sent-swap-redo.mix <user@domain> <topup-ts> [--commit] [--was-sent]"); exit(1) end
$login = $a[0]
$TS = $a[1]
$commit = 0
$was_sent = 0
$i = 2
while $i < len($a)
  if $a[$i] == "--commit" then
    $commit = 1
  end
  if $a[$i] == "--was-sent" then
    $was_sent = 1
  end
  $i = $i + 1
end

$up = split($login, "@")
$D = "/srv/" .. $up[1] .. "/msg/" .. $up[0]
$dbdir = $D .. "/.spamlite"
$db = $dbdir .. "/db.sqlite"
$log = $dbdir .. "/reconciled.log"
$SL = "/usr/local/bin/spamlite"
if is_file($db) == false then print("FAIL: no db at " .. $db); exit(1) end
if is_file($log) == false then print("FAIL: no sidecar at " .. $log); exit(1) end

-- 1. cohort keys
$cohort = {}
$ncohort = 0
$keep = []
$ll = read_lines($log)
$i = 0
while $i < len($ll)
  $l = $ll[$i]
  $p = split($l, " ")
  if len($p) >= 3 and $p[0] == "G" and $p[1] == $TS then
    $cohort[$p[2]] = 1
    $ncohort = $ncohort + 1
  else
    if strip($l) != "" then
      push($keep, $l)
    end
  end
  $i = $i + 1
end
print("cohort G@" .. $TS .. " = " .. $ncohort .. " keys; sidecar lines kept = " .. len($keep))
if $ncohort == 0 then print("FAIL: no sidecar entries at that timestamp"); exit(1) end

-- 2. map keys -> Sent files
$m = run_argv([$SL, "msgids", $D .. "/Maildir/.Sent/cur"], {timeout: 600})
if $m.exit_code != 0 then print("FAIL: msgids: " .. strip($m.stderr)); exit(1) end
$paths = []
$seen_key = {}
$ml = split($m.stdout, "\n")
$i = 0
while $i < len($ml)
  $p = split($ml[$i], "\t")
  if len($p) >= 3 then
    $k = lower(replace(replace($p[0], "<", ""), ">", ""))
    if $cohort[$k] != nil and $seen_key[$k] == nil then
      $seen_key[$k] = 1
      $path = $p[2]
      if pos("/", $path) != 1 then $path = $D .. "/" .. $path end
      push($paths, $path)
    end
  end
  $i = $i + 1
end
$stranded = $ncohort - len($paths)
print("resolved to files = " .. len($paths) .. "; stranded (message deleted since) = " .. $stranded)
if $stranded > 0 then
  print("  NOTE: stranded ham counts cannot be untrained and stay in the corpus.")
end

if $commit == 0 then
  print("")
  print("DRY RUN — re-run with --commit to back up, untrain " .. len($paths) .. " messages, and rewrite the sidecar.")
  exit(0)
end

-- 3. backups
-- Epoch-stamped: a second run must never clobber the backup taken by the
-- first, which may be the only exact record of the pre-redo corpus.
$stamp = "presentswap-" .. floor(time())
$bk = $db .. ".bak-" .. $stamp
$b = run_argv(["sqlite3", $db, ".backup '" .. $bk .. "'"], {timeout: 600})
if $b.exit_code != 0 then print("FAIL: db backup: " .. strip($b.stderr)); exit(1) end
copy($log, $log .. ".bak-" .. $stamp)
print("backed up -> " .. $bk .. " and " .. $log .. ".bak-" .. $stamp)
print($SL .. " stats BEFORE:")
print(run_argv([$SL, "-d", $dbdir, "stats"]).stdout)

-- 4. untrain with the geometry the cohort was trained with
$uargv = [$SL, "-d", $dbdir, "untrain", "good"]
if $was_sent == 1 then
  $uargv = concat($uargv, ["--sent"])
end
print("untrain geometry: " .. join(slice($uargv, 3, len($uargv)), " "))
$ok = 0
$fail = 0
$i = 0
while $i < len($paths)
  $r = run_argv($uargv, {stdin: {file: $paths[$i]}, timeout: 60})
  if $r.exit_code == 0 then
    $ok = $ok + 1
  else
    $fail = $fail + 1
    if $fail <= 5 then
      print("  untrain failed " .. basename($paths[$i]) .. ": " .. strip($r.stderr))
    end
  end
  $i = $i + 1
end
print("untrained ok=" .. $ok .. " fail=" .. $fail)

-- 5. rewrite the sidecar without the cohort
$out = ""
$i = 0
while $i < len($keep)
  $out = $out .. $keep[$i] .. "\n"
  $i = $i + 1
end
write_file($log .. ".tmp", $out)
rename($log .. ".tmp", $log)
$owner = strip(run_argv(["stat", "-c", "%U:%G", $db]).stdout)
run_argv(["chown", "-R", $owner, $dbdir])
print("sidecar rewritten (" .. len($keep) .. " lines), ownership restored to " .. $owner)
print($SL .. " stats AFTER untrain:")
print(run_argv([$SL, "-d", $dbdir, "stats"]).stdout)
print("Now re-run: /usr/local/bin/spamlite-sent-ham-topup.mix " .. $login)
