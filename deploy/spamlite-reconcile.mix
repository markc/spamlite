#!/opt/cosmix/bin/mix
-- spamlite-reconcile.mix — nightly STATE-based trainer.
--
-- Folder state is the label source, not imapsieve events (events lose ~97% of
-- corrections; state cannot lie — ~/.ns mbc _journal/2026-08-21 session 3):
--   spam: everything in Junk
--   ham:  everything in INBOX older than RIPEN (survived triage) and younger
--         than WINDOW (older mail either trained already or missed)
--   never: Trash (deletion is not a class signal), unseen new/ mail
--
-- Mailbox access per user dir (auto-detected):
--   Maildir/  — direct file globs (Junk = .Junk/{cur,new}, ham = cur/ by
--               basename epoch), staged as symlinks.
--   mdbox/    — via doveadm (login derived from the path:
--               <root>/<domain>/msg/<user> -> user@domain): enumeration with
--               `doveadm fetch "uid hdr.message-id hdr.from" <query>`, ham
--               window with `savedsince/savedbefore`, selected messages
--               fetched into staging files named by uid.
--
-- Sidecar .spamlite/reconciled.log ("class epoch key" per line, last entry
-- wins) makes each message train once per class. One corrective retrain is
-- allowed on a class flip; after 2 entries a key is frozen (flip-flop guard).
-- Keys: lowercased Message-ID without <>, else f:<maildir-basename> /
-- f:<uid> (fallback keys don't survive folder moves — accepted).
--
-- Rails: per-night per-class cap (default 200, oldest first, remainder next
-- night); both classes trained each night when both have candidates (batch
-- order is irrelevant — token counts are commutative; F9's real hazard is
-- one-sided training over TIME); label headers stripped in-binary by
-- train-dir; a user with an empty corpus side is skipped; a
-- `.spamlite/reconcile-ham-only` marker file trains the HAM SIDE ONLY — for
-- users whose Junk cannot be trusted as spam (the junk-as-ham sick cohort:
-- their Junk holds their ham; ham-only reconciliation grows retention ham
-- until their FP situation clears, then the marker comes off);
-- WAL/shm/log chowned back to the mail user after a root run.
--
-- Engine: spamlite >= 0.9.0 (stats / msgids / train-dir). train-dir's ok
-- rows print post-commit, so a sidecar entry is only ever written for a
-- durably trained message.
--
-- Usage: spamlite-reconcile.mix [--dry-run] [--cap N] [--root DIR] [path-substring-filter]

$SL = "/usr/local/bin/spamlite"
$RIPEN = 259200
$WINDOW = 2592000
$CAP = 200
$DRY = 0
$FILTER = ""
$ROOT = "/srv"

$a = args()
$i = 0
while $i < len($a)
  if $a[$i] == "--dry-run" then
    $DRY = 1
  else
    if $a[$i] == "--cap" then
      $i = $i + 1
      $CAP = to_number($a[$i])
    else
    if $a[$i] == "--root" then
      $i = $i + 1
      $ROOT = $a[$i]
    else
      $FILTER = $a[$i]
    end
    end
  end
  $i = $i + 1
end

$NOW = floor(time())
$HAM_HI = $NOW - $RIPEN
$HAM_LO = $NOW - $WINDOW
$STAGE = "/dev/shm/slrec." .. $NOW

$users = glob($ROOT .. "/*/msg/*")
$u = 0
while $u < len($users)
  $d = $users[$u]
  $go = 1
  if $FILTER != "" then
    if pos($FILTER, $d) == 0 then
      $go = 0
    end
  end
  if is_file($d .. "/.spamlite/db.sqlite") == false then
    $go = 0
  end
  $mode = ""
  if $go == 1 then
    if is_dir($d .. "/Maildir") then
      $mode = "maildir"
    else
      if is_dir($d .. "/mdbox") then
        $mode = "mdbox"
      else
        $go = 0
      end
    end
  end
  if $go == 1 then
    $db = $d .. "/.spamlite"
    $log = $db .. "/reconciled.log"
    $hamonly = 0
    if is_file($db .. "/reconcile-ham-only") then
      $hamonly = 1
    end

    -- rail: both corpus sides must be non-empty (one stats call, one snapshot)
    $st = run_argv([$SL, "-d", $db, "stats"])
    $tg = 0
    $ts = 0
    $sl = split(strip($st.stdout), "\n")
    $si = 0
    while $si < len($sl)
      $p = split($sl[$si], " ")
      if len($p) >= 2 then
        if $p[0] == "good" then
          $tg = to_number($p[1])
        end
        if $p[0] == "spam" then
          $ts = to_number($p[1])
        end
      end
      $si = $si + 1
    end
    if $tg == 0 then
      print($d .. ": SKIP — empty good side (seed decision needed)")
      $go = 0
    end
    if $ts == 0 then
      print($d .. ": SKIP — empty spam side (seed decision needed)")
      $go = 0
    end
  end
  if $go == 1 then
    -- load sidecar log: key -> last class, key -> entry count
    $seen = {}
    $cnt = {}
    if is_file($log) then
      $lines = read_lines($log)
      $li = 0
      while $li < len($lines)
        $p = split($lines[$li], " ")
        if len($p) >= 3 then
          $seen[$p[2]] = $p[0]
          $n = $cnt[$p[2]]
          if $n == nil then
            $n = 0
          end
          $cnt[$p[2]] = $n + 1
        end
        $li = $li + 1
      end
    end

    -- ============ enumeration: candidates as "SORT|CLS|ID|BN" ============
    -- ID: maildir = source path; mdbox = "<box> <uid>". BN: staging basename
    -- (maildir basename sans :2,flags / uid) — the join key for key/from maps.
    $cand = []
    $key_bn = {}
    $from_bn = {}
    $njunk = 0
    $nham = 0

    if $mode == "maildir" then
      $junk = []
      if $hamonly == 0 then
        $junk = concat(glob($d .. "/Maildir/.Junk/cur/*"), glob($d .. "/Maildir/.Junk/new/*"))
      end
      $inbox = []
      $all = glob($d .. "/Maildir/cur/*")
      $ai = 0
      while $ai < len($all)
        $ps = split($all[$ai], "/")
        $b = $ps[len($ps) - 1]
        $e = to_number(substr($b, 0, 10))
        if $e >= $HAM_LO then
          if $e <= $HAM_HI then
            push($inbox, $all[$ai])
          end
        end
        $ai = $ai + 1
      end
      $njunk = len($junk)
      $nham = len($inbox)

      -- keys via `spamlite msgids`: Junk dirs scanned whole; the inbox window
      -- is a subset of cur/, so it is staged as symlinks for its scan. A file
      -- expunged mid-run makes msgids exit non-zero; the remaining output is
      -- still valid, so rc is deliberately ignored.
      $scan = $STAGE .. ".scan"
      remove_dir($scan)
      mkdir($scan)
      if len($inbox) > 0 then
        run_argv(concat(["ln", "-s", "-t", $scan], $inbox))
      end
      $kl = []
      if $hamonly == 0 then
        if len(glob($d .. "/Maildir/.Junk/cur/*")) > 0 then
          $r = run_argv([$SL, "msgids", $d .. "/Maildir/.Junk/cur"], {timeout: 300})
          $kl = concat($kl, split(strip($r.stdout), "\n"))
        end
        if len(glob($d .. "/Maildir/.Junk/new/*")) > 0 then
          $r = run_argv([$SL, "msgids", $d .. "/Maildir/.Junk/new"], {timeout: 300})
          $kl = concat($kl, split(strip($r.stdout), "\n"))
        end
      end
      if len($inbox) > 0 then
        $r = run_argv([$SL, "msgids", $scan], {timeout: 300})
        $kl = concat($kl, split(strip($r.stdout), "\n"))
      end
      remove_dir($scan)
      $ki = 0
      while $ki < len($kl)
        $p = split($kl[$ki], "\t")
        if len($p) >= 3 then
          $ps = split($p[2], "/")
          $bn = $ps[len($ps) - 1]
          $fl = pos(":2,", $bn)
          if $fl > 0 then
            $bn = substr($bn, 0, $fl - 1)
          end
          $key = ""
          if $p[0] != "-" then
            $key = lower($p[0])
          end
          if $key == "" then
            $key = "f:" .. $bn
          end
          $key_bn[$bn] = $key
          $from_bn[$bn] = $p[1]
        end
        $ki = $ki + 1
      end

      $sets = [["S", $junk], ["G", $inbox]]
      $si = 0
      while $si < len($sets)
        $cls = $sets[$si][0]
        $files = $sets[$si][1]
        $fi = 0
        while $fi < len($files)
          $f = $files[$fi]
          $ps = split($f, "/")
          $b = $ps[len($ps) - 1]
          $bn = $b
          $fl = pos(":2,", $bn)
          if $fl > 0 then
            $bn = substr($bn, 0, $fl - 1)
          end
          push($cand, substr($b, 0, 10) .. "|" .. $cls .. "|" .. $f .. "|" .. $bn)
          $fi = $fi + 1
        end
        $si = $si + 1
      end
    end

    if $mode == "mdbox" then
      -- login from the path: <root>/<domain>/msg/<user>
      $ps = split($d, "/")
      $login = $ps[len($ps) - 1] .. "@" .. $ps[len($ps) - 3]
      $plans = []
      if $hamonly == 0 then
        push($plans, ["S", "Junk", ["mailbox", "Junk"]])
      end
      push($plans, ["G", "INBOX", ["mailbox", "INBOX", "savedsince", "" .. $HAM_LO, "savedbefore", "" .. $HAM_HI]])
      $pi = 0
      while $pi < len($plans)
        $cls = $plans[$pi][0]
        $box = $plans[$pi][1]
        $q = $plans[$pi][2]
        $r = run_argv(concat(["doveadm", "fetch", "-u", $login, "uid hdr.message-id hdr.from"], $q), {timeout: 600})
        $uid = ""
        $mid = ""
        $frm = ""
        $last = ""
        $ls = []
        if strip($r.stdout) != "" then
          $ls = split($r.stdout, "\n")
        end
        push($ls, "uid: END")
        $li = 0
        while $li < len($ls)
          $line = $ls[$li]
          if pos("uid: ", $line) == 1 then
            if $uid != "" then
              $key = lower(replace(replace(replace($mid, "<", ""), ">", ""), " ", ""))
              if $key == "" then
                $key = "f:" .. $uid
              end
              $key_bn[$uid] = $key
              $from_bn[$uid] = $frm
              $z = "0000000000" .. $uid
              push($cand, substr($z, len($z) - 10, 10) .. "|" .. $cls .. "|" .. $box .. " " .. $uid .. "|" .. $uid)
              if $cls == "S" then
                $njunk = $njunk + 1
              else
                $nham = $nham + 1
              end
            end
            $uid = strip(substr($line, 5, len($line) - 5))
            $mid = ""
            $frm = ""
            $last = ""
          else
            if pos("hdr.message-id:", $line) == 1 then
              $mid = strip(substr($line, 15, len($line) - 15))
              $last = "mid"
            else
              if pos("hdr.from:", $line) == 1 then
                $frm = strip(substr($line, 9, len($line) - 9))
                $last = "frm"
              else
                if pos(" ", $line) == 1 then
                  -- folded header continuation
                  if $last == "mid" then
                    $mid = $mid .. strip($line)
                  end
                end
                if pos("\t", $line) == 1 then
                  if $last == "mid" then
                    $mid = $mid .. strip($line)
                  end
                end
              end
            end
          end
          $li = $li + 1
        end
        $pi = $pi + 1
      end
    end

    if len($cand) == 0 then
      print($d .. ": nothing in scope")
    else
      -- ============ policy: dedupe, flips, caps (mode-independent) ============
      $cand = sort($cand)
      $ns = 0
      $ng = 0
      $ncorr = 0
      $defer = 0
      $fail = 0
      $skip_done = 0
      $skip_frozen = 0
      $sample_s = 0
      $sample_g = 0
      $sel_s = []
      $sel_g = []
      $corr_of_bn = {}
      $ti = 0
      while $ti < len($cand)
        $p = split($cand[$ti], "|")
        $cls = $p[1]
        $id = $p[2]
        $bn = $p[3]
        $key = $key_bn[$bn]
        $want = 0
        $corr = 0
        if $key != nil then
          $c = $seen[$key]
          $want = 1
          $other = "G"
          if $cls == "G" then
            $other = "S"
          end
          if $c == $cls then
            $want = 0
            $skip_done = $skip_done + 1
          end
          if $c == $other then
            $n = $cnt[$key]
            if $n >= 2 then
              $want = 0
              $skip_frozen = $skip_frozen + 1
            else
              $corr = 1
            end
          end
        end
        if $want == 1 then
          $room = 1
          if $cls == "S" then
            if $ns >= $CAP then
              $room = 0
            end
          else
            if $ng >= $CAP then
              $room = 0
            end
          end
          if $room == 0 then
            $defer = $defer + 1
          else
            if $cls == "S" then
              $ns = $ns + 1
            else
              $ng = $ng + 1
            end
            if $corr == 1 then
              $ncorr = $ncorr + 1
              $corr_of_bn[$bn] = 1
            end
            if $DRY == 1 then
              $show = 0
              if $cls == "S" then
                if $sample_s < 5 then
                  $sample_s = $sample_s + 1
                  $show = 1
                end
              else
                if $sample_g < 5 then
                  $sample_g = $sample_g + 1
                  $show = 1
                end
              end
              if $show == 1 then
                $fr = $from_bn[$bn]
                if $fr == nil then
                  $fr = "-"
                end
                print("  would-train " .. $cls .. " corr=" .. $corr .. " From: " .. $fr)
              end
            else
              if $cls == "S" then
                push($sel_s, [$id, $bn])
              else
                push($sel_g, [$id, $bn])
              end
            end
          end
        end
        $ti = $ti + 1
      end

      -- ============ staging + train-dir + sidecar (mode-aware staging) ============
      if $DRY == 0 then
        $ns = 0
        $ng = 0
        $sets = [["spam", "S", $sel_s], ["good", "G", $sel_g]]
        $si = 0
        while $si < len($sets)
          $cmd = $sets[$si][0]
          $cls = $sets[$si][1]
          $sel = $sets[$si][2]
          if len($sel) > 0 then
            $sd = $STAGE .. "." .. $cmd
            remove_dir($sd)
            mkdir($sd)
            if $mode == "maildir" then
              $paths = []
              $xi = 0
              while $xi < len($sel)
                push($paths, $sel[$xi][0])
                $xi = $xi + 1
              end
              run_argv(concat(["ln", "-s", "-t", $sd], $paths))
            else
              $ps = split($d, "/")
              $login = $ps[len($ps) - 1] .. "@" .. $ps[len($ps) - 3]
              $xi = 0
              while $xi < len($sel)
                $bp = split($sel[$xi][0], " ")
                run_argv(["doveadm", "fetch", "-u", $login, "text", "mailbox", $bp[0], "uid", $bp[1]], {stdout: {file: $sd .. "/raw"}})
                run_argv(["sed", "1d", $sd .. "/raw"], {stdout: {file: $sd .. "/" .. $sel[$xi][1]}})
                $xi = $xi + 1
              end
              run_argv(["rm", "-f", $sd .. "/raw"])
            end
            $tr = run_argv([$SL, "-d", $db, "train-dir", $sd, $cmd], {timeout: 1800})
            $tl = []
            if strip($tr.stdout) != "" then
              $tl = split(strip($tr.stdout), "\n")
            end
            $tli = 0
            while $tli < len($tl)
              $p = split($tl[$tli], "\t")
              if len($p) >= 3 then
                if $p[0] == "ok" then
                  $ps2 = split($p[2], "/")
                  $bn = $ps2[len($ps2) - 1]
                  $fl = pos(":2,", $bn)
                  if $fl > 0 then
                    $bn = substr($bn, 0, $fl - 1)
                  end
                  $key = $key_bn[$bn]
                  if $key != nil then
                    append_file($log, $cls .. " " .. $NOW .. " " .. $key .. "\n")
                    if $cls == "S" then
                      $ns = $ns + 1
                    else
                      $ng = $ng + 1
                    end
                  end
                else
                  $fail = $fail + 1
                end
              end
              $tli = $tli + 1
            end
            $fail = $fail + (len($sel) - len($tl))
            remove_dir($sd)
          end
          $si = $si + 1
        end
      end

      $modetag = $mode
      if $hamonly == 1 then
        $modetag = $mode .. "/HAM-ONLY"
      end
      $verb = "trained"
      if $DRY == 1 then
        $verb = "would-train"
      end
      print($d .. " [" .. $modetag .. "]: junk=" .. $njunk .. " inbox-window=" .. $nham .. " | " .. $verb .. " spam=" .. $ns .. " good=" .. $ng .. " (corrective=" .. $ncorr .. ") | already=" .. $skip_done .. " frozen=" .. $skip_frozen .. " deferred=" .. $defer .. " failed=" .. $fail)

      -- root-run hygiene: give WAL/shm/log back to the mail user
      if $DRY == 0 then
        $own = []
        if is_file($db .. "/db.sqlite-wal") then
          push($own, $db .. "/db.sqlite-wal")
        end
        if is_file($db .. "/db.sqlite-shm") then
          push($own, $db .. "/db.sqlite-shm")
        end
        if is_file($log) then
          push($own, $log)
        end
        if len($own) > 0 then
          run_argv(concat(["chown", "--reference=" .. $db .. "/db.sqlite"], $own))
        end
      end
    end
  end
  $u = $u + 1
end
