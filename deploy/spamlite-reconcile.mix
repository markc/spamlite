#!/opt/cosmix/bin/mix
-- spamlite-reconcile.mix — nightly STATE-based trainer.
--
-- Folder state is the label source, not imapsieve events (events lose ~97% of
-- corrections; state cannot lie — ~/.ns mbc _journal/2026-08-21 session 3):
--   spam: everything in Maildir/.Junk/{cur,new}
--   ham:  everything in Maildir/cur older than RIPEN (survived triage) and
--         younger than WINDOW (older mail either trained already or missed)
--   never: Trash (deletion is not a class signal), new/ (unseen)
--
-- Sidecar .spamlite/reconciled.log ("class epoch key" per line, last entry
-- wins) makes each message train once per class. One corrective retrain is
-- allowed on a class flip (ham-ripened mail later dragged to Junk, or a
-- rescue); after 2 entries a key is frozen (flip-flop guard).
--
-- Rails: per-night per-class cap (default 200, oldest first, remainder next
-- night); BOTH classes trained each night when both have candidates (one-
-- sided mass over time shifts scores — F9; within-batch ORDER is irrelevant,
-- token counts are commutative, so batch-per-class training is exact);
-- X-Spam-Status/X-SpamProbe stripped in-binary by train-dir; a user with an
-- empty corpus side is skipped (seed decision needed first); WAL/shm/log
-- chowned back to the mail user after a root run.
--
-- Engine: spamlite >= 0.9.0 — `stats` (rail check), `msgids` (key extraction,
-- replaced reconcile-keyext.awk), `train-dir` (bulk training via a /dev/shm
-- symlink staging dir, one durable transaction per chunk, replaced the
-- per-message strip.awk|spamlite exec loop). Sidecar keys stay
-- keyext-compatible: lowercased Message-ID without <>, f:<basename> fallback.
-- train-dir's ok rows are printed post-commit, so a sidecar entry is only
-- ever written for a durably trained message.
--
-- Usage: spamlite-reconcile.mix [--dry-run] [--cap N] [--root DIR] [path-substring-filter]

$SL = "/usr/local/bin/spamlite"
$RIPEN = 259200
$WINDOW = 2592000
$CAP = 200
$DRY = 0
$FILTER = ""
$ROOT = "/srv"

$a = args()
$i = 0
while $i < len($a)
  if $a[$i] == "--dry-run" then
    $DRY = 1
  else
    if $a[$i] == "--cap" then
      $i = $i + 1
      $CAP = to_number($a[$i])
    else
    if $a[$i] == "--root" then
      $i = $i + 1
      $ROOT = $a[$i]
    else
      $FILTER = $a[$i]
    end
    end
  end
  $i = $i + 1
end

$NOW = floor(time())
$HAM_HI = $NOW - $RIPEN
$HAM_LO = $NOW - $WINDOW
$STAGE = "/dev/shm/slrec." .. $NOW

-- basename of a path, with the maildir ":2,flags" suffix removed — the
-- f:<basename> fallback key must be stable across a new/ -> cur/ move.
-- (Defined inline where used; Mix has no user functions.)

$users = glob($ROOT .. "/*/msg/*")
$u = 0
while $u < len($users)
  $d = $users[$u]
  $go = 1
  if $FILTER != "" then
    if pos($FILTER, $d) == 0 then
      $go = 0
    end
  end
  if is_file($d .. "/.spamlite/db.sqlite") == false then
    $go = 0
  end
  if $go == 1 then
    $db = $d .. "/.spamlite"
    $log = $db .. "/reconciled.log"

    -- rail: both corpus sides must be non-empty (one stats call, one snapshot)
    $st = run_argv([$SL, "-d", $db, "stats"])
    $tg = 0
    $ts = 0
    $sl = split(strip($st.stdout), "\n")
    $si = 0
    while $si < len($sl)
      $p = split($sl[$si], " ")
      if len($p) >= 2 then
        if $p[0] == "good" then
          $tg = to_number($p[1])
        end
        if $p[0] == "spam" then
          $ts = to_number($p[1])
        end
      end
      $si = $si + 1
    end
    if $tg == 0 then
      print($d .. ": SKIP — empty good side (seed decision needed)")
      $go = 0
    end
    if $ts == 0 then
      print($d .. ": SKIP — empty spam side (seed decision needed)")
      $go = 0
    end
  end
  if $go == 1 then
    -- load sidecar log: key -> last class, key -> entry count
    $seen = {}
    $cnt = {}
    if is_file($log) then
      $lines = read_lines($log)
      $li = 0
      while $li < len($lines)
        $p = split($lines[$li], " ")
        if len($p) >= 3 then
          $seen[$p[2]] = $p[0]
          $n = $cnt[$p[2]]
          if $n == nil then
            $n = 0
          end
          $cnt[$p[2]] = $n + 1
        end
        $li = $li + 1
      end
    end

    -- candidates
    $junk = concat(glob($d .. "/Maildir/.Junk/cur/*"), glob($d .. "/Maildir/.Junk/new/*"))
    $inbox = []
    $all = glob($d .. "/Maildir/cur/*")
    $ai = 0
    while $ai < len($all)
      $ps = split($all[$ai], "/")
      $b = $ps[len($ps) - 1]
      $e = to_number(substr($b, 0, 10))
      if $e >= $HAM_LO then
        if $e <= $HAM_HI then
          push($inbox, $all[$ai])
        end
      end
      $ai = $ai + 1
    end

    $cand = concat($junk, $inbox)
    if len($cand) == 0 then
      print($d .. ": nothing in scope")
    else
      -- keys via `spamlite msgids` per source dir. The inbox window is a
      -- SUBSET of Maildir/cur, so it is staged as symlinks first — msgids
      -- scans whole directories. A file expunged mid-run makes msgids exit
      -- non-zero; its remaining output is still valid, and the vanished file
      -- simply cannot train tonight, so rc is deliberately ignored here.
      $scan = $STAGE .. ".scan"
      remove_dir($scan)
      mkdir($scan)
      if len($inbox) > 0 then
        run_argv(concat(["ln", "-s", "-t", $scan], $inbox))
      end
      $kl = []
      if len(glob($d .. "/Maildir/.Junk/cur/*")) > 0 then
        $r = run_argv([$SL, "msgids", $d .. "/Maildir/.Junk/cur"], {timeout: 300})
        $kl = concat($kl, split(strip($r.stdout), "\n"))
      end
      if len(glob($d .. "/Maildir/.Junk/new/*")) > 0 then
        $r = run_argv([$SL, "msgids", $d .. "/Maildir/.Junk/new"], {timeout: 300})
        $kl = concat($kl, split(strip($r.stdout), "\n"))
      end
      if len($inbox) > 0 then
        $r = run_argv([$SL, "msgids", $scan], {timeout: 300})
        $kl = concat($kl, split(strip($r.stdout), "\n"))
      end
      remove_dir($scan)

      -- maps: basename -> key (keyext-compatible), basename -> From
      $key_bn = {}
      $from_bn = {}
      $ki = 0
      while $ki < len($kl)
        $p = split($kl[$ki], "\t")
        if len($p) >= 3 then
          $ps = split($p[2], "/")
          $bn = $ps[len($ps) - 1]
          $fl = pos(":2,", $bn)
          if $fl > 0 then
            $bn = substr($bn, 0, $fl - 1)
          end
          $key = ""
          if $p[0] != "-" then
            $key = lower($p[0])
          end
          if $key == "" then
            $key = "f:" .. $bn
          end
          $key_bn[$bn] = $key
          $from_bn[$bn] = $p[1]
        end
        $ki = $ki + 1
      end

      -- decide actions: "EPOCH|CLASS|CORR|PATH|KEY"
      $actions = []
      $skip_done = 0
      $skip_frozen = 0
      $ji = 0
      while $ji < len($junk)
        $f = $junk[$ji]
        $ps = split($f, "/")
        $b = $ps[len($ps) - 1]
        $bn = $b
        $fl = pos(":2,", $bn)
        if $fl > 0 then
          $bn = substr($bn, 0, $fl - 1)
        end
        $key = $key_bn[$bn]
        if $key != nil then
          $c = $seen[$key]
          $corr = 0
          $want = 1
          if $c == "S" then
            $want = 0
            $skip_done = $skip_done + 1
          end
          if $c == "G" then
            $n = $cnt[$key]
            if $n >= 2 then
              $want = 0
              $skip_frozen = $skip_frozen + 1
            else
              $corr = 1
            end
          end
          if $want == 1 then
            push($actions, substr($b, 0, 10) .. "|S|" .. $corr .. "|" .. $f .. "|" .. $key)
          end
        end
        $ji = $ji + 1
      end
      $hi = 0
      while $hi < len($inbox)
        $f = $inbox[$hi]
        $ps = split($f, "/")
        $b = $ps[len($ps) - 1]
        $bn = $b
        $fl = pos(":2,", $bn)
        if $fl > 0 then
          $bn = substr($bn, 0, $fl - 1)
        end
        $key = $key_bn[$bn]
        if $key != nil then
          $c = $seen[$key]
          $corr = 0
          $want = 1
          if $c == "G" then
            $want = 0
            $skip_done = $skip_done + 1
          end
          if $c == "S" then
            $n = $cnt[$key]
            if $n >= 2 then
              $want = 0
              $skip_frozen = $skip_frozen + 1
            else
              $corr = 1
            end
          end
          if $want == 1 then
            push($actions, substr($b, 0, 10) .. "|G|" .. $corr .. "|" .. $f .. "|" .. $key)
          end
        end
        $hi = $hi + 1
      end

      -- time-sort, apply per-class caps oldest-first, collect per class
      $actions = sort($actions)
      $ns = 0
      $ng = 0
      $ncorr = 0
      $defer = 0
      $fail = 0
      $sample_s = 0
      $sample_g = 0
      $stage_s = []
      $stage_g = []
      $key_of_bn = {}
      $corr_of_bn = {}
      $ti = 0
      while $ti < len($actions)
        $p = split($actions[$ti], "|")
        $cls = $p[1]
        $corr = $p[2]
        $f = $p[3]
        $key = $p[4]
        $room = 1
        if $cls == "S" then
          if $ns >= $CAP then
            $room = 0
          end
        else
          if $ng >= $CAP then
            $room = 0
          end
        end
        if $room == 0 then
          $defer = $defer + 1
        else
          $ps = split($f, "/")
          $bn = $ps[len($ps) - 1]
          $fl = pos(":2,", $bn)
          if $fl > 0 then
            $bn = substr($bn, 0, $fl - 1)
          end
          if $DRY == 1 then
            $show = 0
            if $cls == "S" then
              $ns = $ns + 1
              if $sample_s < 5 then
                $sample_s = $sample_s + 1
                $show = 1
              end
            else
              $ng = $ng + 1
              if $sample_g < 5 then
                $sample_g = $sample_g + 1
                $show = 1
              end
            end
            if $corr == "1" then
              $ncorr = $ncorr + 1
            end
            if $show == 1 then
              $fr = $from_bn[$bn]
              if $fr == nil then
                $fr = "-"
              end
              print("  would-train " .. $cls .. " corr=" .. $corr .. " From: " .. $fr)
            end
          else
            $key_of_bn[$bn] = $key
            $corr_of_bn[$bn] = $corr
            if $cls == "S" then
              push($stage_s, $f)
              $ns = $ns + 1
            else
              push($stage_g, $f)
              $ng = $ng + 1
            end
          end
        end
        $ti = $ti + 1
      end

      -- bulk-train each class from a symlink staging dir. Sidecar entries are
      -- written ONLY from train-dir's post-commit ok rows; err rows and files
      -- that vanished mid-run count as failed and retry next night.
      if $DRY == 0 then
        $ns = 0
        $ng = 0
        $sets = 0
        while $sets < 2
          $cls = "S"
          $cmd = "spam"
          $stage_files = $stage_s
          if $sets == 1 then
            $cls = "G"
            $cmd = "good"
            $stage_files = $stage_g
          end
          if len($stage_files) > 0 then
            $sd = $STAGE .. "." .. $cmd
            remove_dir($sd)
            mkdir($sd)
            run_argv(concat(["ln", "-s", "-t", $sd], $stage_files))
            $tr = run_argv([$SL, "-d", $db, "train-dir", $sd, $cmd], {timeout: 1800})
            $tl = []
            if strip($tr.stdout) != "" then
              $tl = split(strip($tr.stdout), "\n")
            end
            $tli = 0
            while $tli < len($tl)
              $p = split($tl[$tli], "\t")
              if len($p) >= 3 then
                if $p[0] == "ok" then
                  $ps = split($p[2], "/")
                  $bn = $ps[len($ps) - 1]
                  $fl = pos(":2,", $bn)
                  if $fl > 0 then
                    $bn = substr($bn, 0, $fl - 1)
                  end
                  $key = $key_of_bn[$bn]
                  if $key != nil then
                    append_file($log, $cls .. " " .. $NOW .. " " .. $key .. "\n")
                    if $cls == "S" then
                      $ns = $ns + 1
                    else
                      $ng = $ng + 1
                    end
                    if $corr_of_bn[$bn] == "1" then
                      $ncorr = $ncorr + 1
                    end
                  end
                else
                  $fail = $fail + 1
                end
              end
              $tli = $tli + 1
            end
            $fail = $fail + (len($stage_files) - len($tl))
            remove_dir($sd)
          end
          $sets = $sets + 1
        end
      end

      $mode = "trained"
      if $DRY == 1 then
        $mode = "would-train"
      end
      print($d .. ": junk=" .. len($junk) .. " inbox-window=" .. len($inbox) .. " | " .. $mode .. " spam=" .. $ns .. " good=" .. $ng .. " (corrective=" .. $ncorr .. ") | already=" .. $skip_done .. " frozen=" .. $skip_frozen .. " deferred=" .. $defer .. " failed=" .. $fail)

      -- root-run hygiene: give WAL/shm/log back to the mail user
      if $DRY == 0 then
        $own = []
        if is_file($db .. "/db.sqlite-wal") then
          push($own, $db .. "/db.sqlite-wal")
        end
        if is_file($db .. "/db.sqlite-shm") then
          push($own, $db .. "/db.sqlite-shm")
        end
        if is_file($log) then
          push($own, $log)
        end
        if len($own) > 0 then
          run_argv(concat(["chown", "--reference=" .. $db .. "/db.sqlite"], $own))
        end
      end
    end
  end
  $u = $u + 1
end
