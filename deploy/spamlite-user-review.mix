#!/opt/cosmix/bin/mix
-- spamlite-user-review.mix — daily 24h review of one user's spamlite filtering,
-- emailed to markc@renta.net. Fleet-generic (mbc/mrn/mbx): mailbox access is
-- doveadm-based so Maildir and mdbox hosts work identically.
--
--   spamlite-user-review.mix <user@domain> [--to addr] [dryrun]
--
-- --to sends the report to the mailbox owner (or anyone) instead of the
-- default markc@renta.net; when the recipient isn't markc, markc is Cc'd so
-- the ops canary keeps flying.
--
-- Cron (per host, one line per reviewed user), e.g.:
--   0 15 * * * root /opt/cosmix/bin/mix /usr/local/bin/spamlite-user-review.mix brett@brettclarke.com --to brett@brettclarke.com
--
-- Reconciler-stack edition (spamlite 0.9.0): the actionable item is the
-- BORDERLINE JUNK list — junk scored inside [threshold, threshold+0.25), the
-- false-positive risk band; confident junk above that is not worth reading.
-- The threshold comes from the user's params.toml when present, else 0.5
-- (the fleet wrapper default). The summary carries last night's reconciler
-- line, corpus deltas from `spamlite stats` (baseline:
-- /root/spamlite-review-<user>.txt, refreshed each non-dry run), imapsieve
-- retrain counts, and error count.
--
-- "dryrun" prints without emailing or touching the baseline.

$SL = "/usr/local/bin/spamlite"
$RLOG = "/var/log/spamlite-reconcile.log"

$U = ""
$TO = "markc@renta.net"
$DRY = 0
$a = args()
$i = 0
while $i < len($a)
  if $a[$i] == "dryrun" then
    $DRY = 1
  else
    if $a[$i] == "--to" then
      $i = $i + 1
      $TO = $a[$i]
    else
      if pos("@", $a[$i]) > 0 then
        $U = $a[$i]
      end
    end
  end
  $i = $i + 1
end
if $U == "" then
  print("usage: spamlite-user-review.mix <user@domain> [dryrun]")
else

$up = split($U, "@")
$DB = "/srv/" .. $up[1] .. "/msg/" .. $up[0] .. "/.spamlite"
$BASE = "/root/spamlite-review-" .. $U .. ".txt"

-- threshold: params.toml wins, else the fleet wrapper default 0.5
$T = 0.5
if is_file($DB .. "/params.toml") then
  $pl = read_lines($DB .. "/params.toml")
  $pi = 0
  while $pi < len($pl)
    $l = strip($pl[$pi])
    if pos("threshold", $l) == 1 then
      $eq = split($l, "=")
      if len($eq) >= 2 then
        $T = to_number(strip($eq[1]))
      end
    end
    $pi = $pi + 1
  end
end
$BHI = $T + 0.25
$bandlo = substr("" .. $T .. "00", 0, 4)
$bandhi = substr("" .. $BHI .. "00", 0, 4)

-- ---- journald: this user's dovecot lines, last 24h ----
$jr = run_argv(["journalctl", "--since", "1 day ago", "--no-pager", "-g", $U], {timeout: 120})
$lines = []
if strip($jr.stdout) != "" then
  $lines = split($jr.stdout, "\n")
end

$n = 0
$unscored = 0
$inbox = 0
$junk = 0
$b_lo = 0
$b_mid = 0
$b_rev = 0
$b_hi = 0
$tg = 0
$tspam = 0
$score_by_sess = {}
$flagged = []

$li = 0
while $li < len($lines)
  $line = $lines[$li]
  $sess = ""
  $t = split($line, "><")
  if len($t) >= 2 then
    $sess = split($t[1], ">")[0]
  end

  if pos("DELIVERY: " .. $U, $line) > 0 then
    $segs = split($line, "(")
    $body = split($segs[len($segs) - 1], ")")[0]
    $parts = split($body, " ")
    -- unscored outcomes, e.g. "-> Trash (system recipient)", carry no number
    $sc = nil
    if len($parts) >= 2 then
      $sc = to_number($parts[1])
    end
    if $sc == nil then
      $unscored = $unscored + 1
    else
      $n = $n + 1
      if pos("-> Junk", $line) > 0 then
        $junk = $junk + 1
      else
        $inbox = $inbox + 1
      end
      if $sc < 0.1 then
        $b_lo = $b_lo + 1
      else
        if $sc < $T then
          $b_mid = $b_mid + 1
        else
          if $sc < $BHI then
            $b_rev = $b_rev + 1
          else
            $b_hi = $b_hi + 1
          end
        end
      end
      if $sc >= $T then
        if $sc < $BHI then
          if $sess != "" then
            $score_by_sess[$sess] = $parts[1]
          end
        end
      end
    end
  else
    if pos("TRAIN: ", $line) > 0 then
      if pos("-> spam", $line) > 0 then
        $tspam = $tspam + 1
      end
      if pos("-> good", $line) > 0 then
        $tg = $tg + 1
      end
    else
      -- stored-into-Junk line for a borderline session -> resolve From/Subject
      if pos("msgid=<", $line) > 0 then
        if pos("'Junk'", $line) > 0 then
          if $sess != "" then
            $sc = $score_by_sess[$sess]
            if $sc != nil then
              if len($flagged) < 15 then
                $msgid = split(split($line, "msgid=<")[1], ">")[0]
                $from = "(no longer in Junk - rescued/deleted?)"
                $subj = ""
                $df = run_argv(["doveadm", "fetch", "-u", $U, "hdr.from hdr.subject", "mailbox", "Junk", "HEADER", "Message-ID", $msgid], {timeout: 60})
                $hls = split($df.stdout, "\n")
                $hi2 = 0
                while $hi2 < len($hls)
                  $hl = $hls[$hi2]
                  if pos("hdr.from:", $hl) == 1 then
                    if pos("(no longer", $from) == 1 then
                      $from = strip(substr($hl, 9, len($hl) - 9))
                    end
                  end
                  if pos("hdr.subject:", $hl) == 1 then
                    if $subj == "" then
                      $subj = strip(substr($hl, 12, len($hl) - 12))
                    end
                  end
                  $hi2 = $hi2 + 1
                end
                push($flagged, "  [" .. substr($sc, 0, 4) .. "] From: " .. $from .. "\n         Subj: " .. substr($subj, 0, 100) .. "\n         " .. $msgid)
              end
            end
          end
        end
      end
    end
  end
  $li = $li + 1
end

-- ---- errors, host-wide spamlite complaints ----
$er = run_argv(["journalctl", "--since", "1 day ago", "--no-pager", "-g", "spamlite"], {timeout: 120})
$errs = 0
if strip($er.stdout) != "" then
  $els = split($er.stdout, "\n")
  $ei = 0
  while $ei < len($els)
    $el = lower($els[$ei])
    if pos("error", $el) > 0 then
      $errs = $errs + 1
    else
      if pos("panic", $el) > 0 then
        $errs = $errs + 1
      else
        if pos("fail-open", $el) > 0 then
          $errs = $errs + 1
        end
      end
    end
    $ei = $ei + 1
  end
end

-- ---- last reconciler run for this user ----
$rline = ""
if is_file($RLOG) then
  $needle = "/msg/" .. $up[0] .. " ["
  $rls = read_lines($RLOG)
  $ri = 0
  while $ri < len($rls)
    if pos($needle, $rls[$ri]) > 0 then
      if pos("/" .. $up[1] .. "/", $rls[$ri]) > 0 then
        $rline = $rls[$ri]
      end
    end
    $ri = $ri + 1
  end
end
$rsum = "no run logged yet"
if $rline != "" then
  $rs = "?"
  $rg = "?"
  $rc = "?"
  $rf = "?"
  $rp = split(replace(replace($rline, "(", ""), ")", ""), " ")
  $ri = 0
  while $ri < len($rp)
    $p = $rp[$ri]
    if pos("spam=", $p) == 1 then
      $rs = substr($p, 5, len($p) - 5)
    end
    if pos("good=", $p) == 1 then
      $rg = substr($p, 5, len($p) - 5)
    end
    if pos("corrective=", $p) == 1 then
      $rc = substr($p, 11, len($p) - 11)
    end
    if pos("failed=", $p) == 1 then
      $rf = substr($p, 7, len($p) - 7)
    end
    $ri = $ri + 1
  end
  $rsum = "spam +" .. $rs .. "  good +" .. $rg .. "  corrective " .. $rc .. "  failed " .. $rf
end

-- ---- corpus stats now + baseline delta ----
$st = run_argv([$SL, "-d", $DB, "stats"])
$now = {}
$sls = split(strip($st.stdout), "\n")
$si = 0
while $si < len($sls)
  $p = split($sls[$si], " ")
  if len($p) >= 2 then
    $now[$p[0]] = $p[1]
  end
  $si = $si + 1
end
$old = {}
if is_file($BASE) then
  $bls = read_lines($BASE)
  $bi = 0
  while $bi < len($bls)
    $p = split($bls[$bi], " ")
    if len($p) >= 2 then
      $old[$p[0]] = $p[1]
    end
    $bi = $bi + 1
  end
end
$dg = "?"
$ds = "?"
if $old["good"] != nil then
  $d = to_number($now["good"]) - to_number($old["good"])
  $dg = "+" .. $d
  if $d < 0 then
    $dg = "" .. $d
  end
  $d = to_number($now["spam"]) - to_number($old["spam"])
  $ds = "+" .. $d
  if $d < 0 then
    $ds = "" .. $d
  end
end

-- ---- report ----
-- FQDN, not -s: mbc and mrn are both short-named "mail"
$fqdn = strip(run_argv(["hostname", "-f"]).stdout)
$ts = strip(run_argv(["date", "+%Y-%m-%d %H:%M %Z"]).stdout)
$r = "spamlite 24h - " .. $U .. " (" .. $fqdn .. ") - " .. $ts .. "\n\n"
$r = $r .. "SUMMARY\n"
$r = $r .. "  inbound       " .. $n .. " scored: " .. $inbox .. " inbox, " .. $junk .. " junk\n"
if $unscored > 0 then
  $r = $r .. "  unscored      " .. $unscored .. " (no score in DELIVERY line, e.g. system recipient -> Trash)\n"
end
$r = $r .. "  needs review  " .. len($flagged) .. " borderline junk (" .. $bandlo .. "-" .. $bandhi .. ", listed below)\n"
$r = $r .. "  reconciler    " .. $rsum .. "\n"
$r = $r .. "  corpus        good " .. $now["good"] .. " (" .. $dg .. ")  spam " .. $now["spam"] .. " (" .. $ds .. ")\n"
$r = $r .. "  user retrains " .. $tg .. " good, " .. $tspam .. " spam (imapsieve)\n"
$r = $r .. "  errors        " .. $errs .. "\n\n"
$r = $r .. "REVIEW - borderline junk = possible false positives (Junk kept 31d; drag to Inbox to rescue+retrain)\n"
if len($flagged) == 0 then
  $r = $r .. "  none\n"
else
  $fi = 0
  while $fi < len($flagged)
    $r = $r .. $flagged[$fi] .. "\n"
    $fi = $fi + 1
  end
  if len($flagged) >= 15 then
    $r = $r .. "  (capped at 15)\n"
  end
end
$r = $r .. "\nDETAIL\n"
$r = $r .. "  threshold " .. $bandlo .. "  score bands: <0.10 " .. $b_lo .. " | 0.10-under " .. $b_mid .. " | band " .. $b_rev .. " | >=" .. $bandhi .. " " .. $b_hi .. "\n"
$r = $r .. "  tokens " .. $now["tokens"] .. "  trained-last-30d " .. $now["seen_30d"] .. "  db_bytes " .. $now["db_bytes"] .. "\n"
if $rline != "" then
  $r = $r .. "  " .. $rline .. "\n"
end

if $DRY == 1 then
  print("=== DRY RUN (no email, baseline untouched) ===")
  print($r)
else
  $eml = "/dev/shm/spamlite-review." .. $up[0] .. ".eml"
  $cc = ""
  if $TO != "markc@renta.net" then
    $cc = "Cc: markc@renta.net\n"
  end
  -- From root@ on purpose: the fleet global.sieve routes system senders to
  -- Trash BEFORE scoring, so this spam-subject-laden report never pollutes
  -- the corpus. Recipients check Trash for it (same as bounces). 2026-08-23.
  write_file($eml, "To: " .. $TO .. "\n" .. $cc .. "From: root@" .. $fqdn .. "\nSubject: spamlite daily review " .. $U .. "\n\n" .. $r)
  run_argv(["/usr/sbin/sendmail", "-t"], {stdin: {file: $eml}})
  run_argv(["rm", "-f", $eml])
  write_file($BASE, strip($st.stdout) .. "\n")
  print("emailed + baseline refreshed " .. $ts)
end

end
